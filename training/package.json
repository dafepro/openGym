{
  "name": "quicktrack-training",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-boundaries.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:worker": "vitest run --config worker/vitest.config.js",
    "test:content": "node --test scripts/prepare-catalog.test.mjs",
    "test:all": "npm test && npm run test:worker && npm run test:content && npm run test:private-preview && npm run test:release && npm run test:coach",
    "prepare:catalog": "node scripts/prepare-catalog.mjs",
    "test:watch": "vitest",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:build": "node scripts/check-build.mjs",
    "test:private-preview": "node --test scripts/private-preview.test.mjs",
    "test:release": "python3 -m unittest discover -s scripts -p test_release.py && node --test scripts/source-notice.test.mjs",
    "test:e2e": "playwright test",
    "test:coach": "vitest run --config coach/vitest.config.js"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "6.0.4",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "21.0.4",
    "jsqr": "1.4.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
