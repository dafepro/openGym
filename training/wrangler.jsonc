{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "quicktrack-training",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "dist",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "vars": {
    "APP_ORIGIN": "https://train.quicktrack.cc",
    "SESSION_TTL_SECONDS": "43200"
  },
  "r2_buckets": [{ "binding": "TRAINING_CONTENT", "bucket_name": "quicktrack-training-private" }],
  // Reserved proposal only: deploy must verify/assign an unused account namespace.
  "ratelimits": [{ "name": "LOGIN_LIMIT", "namespace_id": "10931001", "simple": { "limit": 6, "period": 60 } }]
}
